@Host = http://localhost:3000

### Обзор платформы и список маршрутов
GET {{Host}}/

### Проверка работоспособности
GET {{Host}}/api/health

### Полиморфная сводка доменных сущностей ООП
GET {{Host}}/api/platform/oop-summary

### Данные платформы для роли Гость (скрыты ответы на тесты, ДЗ и оплаты)
GET {{Host}}/api/bootstrap?role=guest

### Данные платформы для роли Студент
GET {{Host}}/api/bootstrap?role=student

### Данные платформы для роли Преподаватель
GET {{Host}}/api/bootstrap?role=teacher

### Отправка обращения гостя
POST {{Host}}/api/inquiries
Content-Type: application/json

{
  "name": "Сергей Иванов",
  "email": "s.ivanov@example.ru",
  "topic": "Вопросы по программе C# / .NET 8",
  "message": "Хочу уточнить даты старта следующего потока и формат защиты проекта."
}

### Запись студента на курс (мгновенная оплата)
POST {{Host}}/api/courses/course-dotnet-arch/enroll
Content-Type: application/json

{
  "studentId": "stud-ivan",
  "mode": "instant"
}

### Завершение урока и пересчёт прогресса
POST {{Host}}/api/courses/course-data-analytics/lessons/les-an-2/complete
Content-Type: application/json

{
  "studentId": "stud-ivan"
}

### Сохранение личной заметки к уроку
POST {{Host}}/api/courses/course-data-analytics/lessons/les-an-1/note
Content-Type: application/json

{
  "studentId": "stud-ivan",
  "note": "Повторить оконные функции OVER (PARTITION BY) перед вебинаром."
}

### Проверка конфликта расписания вебинара (ожидается 409 Conflict)
POST {{Host}}/api/webinars
Content-Type: application/json

{
  "title": "Пересекающийся вебинар",
  "courseId": "course-csharp-oop",
  "instructorId": "inst-alexey",
  "startTime": "2026-11-28T13:30:00.000Z",
  "endTime": "2026-11-28T14:30:00.000Z",
  "meetingUrl": "https://meet.vector-academy.ru/conflict-test",
  "description": "Проверка доменной валидации пересечений расписания."
}

### Сброс базы data/courses-db.json к исходным демо-данным
POST {{Host}}/api/reset
