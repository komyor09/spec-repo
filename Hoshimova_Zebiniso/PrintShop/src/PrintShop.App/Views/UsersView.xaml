<UserControl x:Class="PrintShop.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Пользователи системы" Style="{StaticResource Header}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="＋ Добавить" Command="{Binding AddCommand}" Style="{StaticResource AccentButton}"/>
                <Button Content="✎ Изменить" Command="{Binding EditCommand}"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#46525F" TextWrapping="Wrap"
                   Text="Администратор — полный доступ; менеджер — заказы, клиенты, оплаты, отчёты; печатник — очередь заказов и смена статусов. Пароли хранятся в виде хэша SHA-256."/>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
