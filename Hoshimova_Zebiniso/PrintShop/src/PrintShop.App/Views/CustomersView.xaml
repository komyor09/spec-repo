<UserControl x:Class="PrintShop.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Клиенты" Style="{StaticResource Header}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="＋ Добавить" Command="{Binding AddCommand}" Style="{StaticResource AccentButton}"/>
                <Button Content="✎ Изменить" Command="{Binding EditCommand}"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                <Button Content="Новый заказ для клиента" Command="{Binding NewOrderCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Поиск (имя, телефон, e-mail):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="90"/>
                    <DataGridTextColumn Header="ФИО / Организация" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*"/>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="2*"/>
                    <DataGridTextColumn Header="Добавлен" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="1" Margin="0,14,0,6">
                <TextBlock Text="История заказов клиента" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="{Binding HistorySummary}" HorizontalAlignment="Right" Foreground="#46525F"/>
            </DockPanel>
            <DataGrid Grid.Row="2" ItemsSource="{Binding History}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="90"/>
                    <DataGridTextColumn Header="Принят" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                    <DataGridTextColumn Header="Продукция" Binding="{Binding Products}" Width="2*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="Долг" Binding="{Binding Debt, StringFormat=N2}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
