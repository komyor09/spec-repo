<UserControl x:Class="PrintShop.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="170"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Отчёты" Style="{StaticResource Header}"/>

        <!-- Сводка -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource Tile}">
                <StackPanel><TextBlock Text="Активных заказов" Foreground="#7A8796"/>
                    <TextBlock Text="{Binding ActiveOrders}" Style="{StaticResource TileValue}" Foreground="{StaticResource PrimaryBrush}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel><TextBlock Text="Просрочено" Foreground="#7A8796"/>
                    <TextBlock Text="{Binding OverdueOrders}" Style="{StaticResource TileValue}" Foreground="#C0392B"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel><TextBlock Text="Срок сегодня" Foreground="#7A8796"/>
                    <TextBlock Text="{Binding DueTodayOrders}" Style="{StaticResource TileValue}" Foreground="#B9770E"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel><TextBlock Text="Задолженность клиентов, сом" Foreground="#7A8796"/>
                    <TextBlock Text="{Binding TotalDebt, StringFormat=N2}" Style="{StaticResource TileValue}"/></StackPanel>
            </Border>
        </StackPanel>

        <!-- Период -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Период с" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding From}" Width="140" Margin="0,0,8,0"/>
            <TextBlock Text="по" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding To}" Width="140" Margin="0,0,10,0"/>
            <Button Content="Сформировать" Command="{Binding BuildCommand}"/>
            <Button Content="Сегодня" Command="{Binding PeriodCommand}" CommandParameter="today" Style="{StaticResource SecondaryButton}" MinWidth="0"/>
            <Button Content="Неделя" Command="{Binding PeriodCommand}" CommandParameter="week" Style="{StaticResource SecondaryButton}" MinWidth="0"/>
            <Button Content="Месяц" Command="{Binding PeriodCommand}" CommandParameter="month" Style="{StaticResource SecondaryButton}" MinWidth="0"/>
            <Button Content="Год" Command="{Binding PeriodCommand}" CommandParameter="year" Style="{StaticResource SecondaryButton}" MinWidth="0"/>
            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,0,12,0"/>
            <Button Content="📤 Экспорт в CSV" Command="{Binding ExportCommand}" Style="{StaticResource AccentButton}"/>
        </WrapPanel>

        <TabControl SelectedIndex="{Binding TabIndex}" Padding="8">
            <TabItem Header="  Выручка за период  ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding RevenueTotal}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <DataGrid ItemsSource="{Binding Revenue}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Кол-во оплат" Binding="{Binding PaymentsCount}" Width="110"/>
                            <DataGridTextColumn Header="Предоплаты, сом" Binding="{Binding Prepayments, StringFormat=N2}" Width="*"/>
                            <DataGridTextColumn Header="Окончательные оплаты, сом" Binding="{Binding FinalPayments, StringFormat=N2}" Width="*"/>
                            <DataGridTextColumn Header="Итого, сом" Binding="{Binding Total, StringFormat=N2}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="  Заказы по видам продукции  ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ProductsTotal}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <DataGrid ItemsSource="{Binding ByProducts}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Вид продукции" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="*"/>
                            <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="*"/>
                            <DataGridTextColumn Header="Общий тираж" Binding="{Binding TotalQuantity, StringFormat=N0}" Width="*"/>
                            <DataGridTextColumn Header="Сумма, сом" Binding="{Binding Revenue, StringFormat=N2}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="  Остатки материалов  ">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox Content="Только ниже минимального запаса" IsChecked="{Binding OnlyLowMaterials}" DockPanel.Dock="Right"/>
                        <TextBlock Text="{Binding MaterialsTotal}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Materials}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BelowMinimum}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource OverdueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="г/м²" Binding="{Binding Density}" Width="60"/>
                            <DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="70"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity, StringFormat=0.##}" Width="80"/>
                            <DataGridTextColumn Header="Мин. запас" Binding="{Binding MinQuantity, StringFormat=0.##}" Width="85"/>
                            <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="50"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=N2}" Width="70"/>
                            <DataGridTextColumn Header="Стоимость остатка" Binding="{Binding StockValue, StringFormat=N2}" Width="*"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
