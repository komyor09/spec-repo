<Window x:Class="PrintShop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Типография: заказы на печать"
        Width="1280" Height="760" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <DockPanel Background="{StaticResource SidebarBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="20,20,20,24">
                <TextBlock Text="🖨 Типография" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="заказы на печать" Foreground="#8C9BAE" FontSize="12"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="16">
                <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding UserRole}" Foreground="#8C9BAE" FontSize="12" Margin="0,0,0,10"/>
                <StackPanel Visibility="{Binding CanBackup, Converter={StaticResource BoolToVis}}">
                    <Button Content="💾 Резервная копия" Command="{Binding BackupCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                    <Button Content="♻ Восстановить БД" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <Button Content="⎋ Выйти" Click="Logout_Click" Style="{StaticResource AccentButton}" Margin="0" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="Nav" Style="{StaticResource NavButton}"
                                     Checked="Nav_Checked" Tag="{Binding}" Loaded="Nav_Loaded">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Width="26"/>
                                <TextBlock Text="{Binding Title}"/>
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Содержимое раздела: View выбирается по типу ViewModel через DataTemplate -->
        <ContentControl Grid.Column="1" Margin="20" Content="{Binding Selected.ViewModel}"/>
    </Grid>
</Window>
