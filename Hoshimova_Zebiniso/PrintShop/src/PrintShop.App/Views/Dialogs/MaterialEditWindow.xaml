<Window x:Class="PrintShop.App.Views.Dialogs.MaterialEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Материал" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20" Width="360">
        <TextBlock Text="Название *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
        <TextBox x:Name="NameBox"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Плотность, г/м²" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DensityBox" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Формат *" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="FormatBox"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Цена за единицу (лист / м²), сом *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PriceBox" Text="0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Остаток на складе" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="QuantityBox" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Минимальный запас" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="MinBox" Text="0"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Для рулонных материалов (баннер) выберите формат «Рулон» — учёт ведётся в м²." Foreground="#7A8796" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
