<Window x:Class="PrintShop.App.Views.Dialogs.CustomerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиент" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20" Width="380">
        <TextBlock Text="Тип клиента" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="PersonRadio" Content="Физическое лицо" IsChecked="True" Margin="0,0,16,0" Checked="Type_Changed"/>
            <RadioButton x:Name="CompanyRadio" Content="Юридическое лицо" Checked="Type_Changed"/>
        </StackPanel>
        <TextBlock x:Name="NameLabel" Text="ФИО *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Телефон *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PhoneBox"/>
        <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="EmailBox"/>
        <TextBlock Text="Адрес" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="AddressBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
