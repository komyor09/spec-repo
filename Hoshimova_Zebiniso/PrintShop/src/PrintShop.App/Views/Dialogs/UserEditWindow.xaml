<Window x:Class="PrintShop.App.Views.Dialogs.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20" Width="320">
        <TextBlock Text="Логин *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
        <TextBox x:Name="LoginBox"/>
        <TextBlock Text="ФИО *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Роль" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="RoleBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
        <TextBlock x:Name="PasswordLabel" Text="Пароль *" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="PasswordBox"/>
        <TextBlock Text="Повтор пароля" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="Password2Box"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
