<Window x:Class="PrintShop.App.Views.Dialogs.AmountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод суммы" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20" Width="320">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="AmountBox" FontSize="16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
