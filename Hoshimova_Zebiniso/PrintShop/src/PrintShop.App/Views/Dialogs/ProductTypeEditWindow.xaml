<Window x:Class="PrintShop.App.Views.Dialogs.ProductTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вид продукции" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20" Width="340">
        <TextBlock Text="Название *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Вид (правило расчёта) *" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="KindBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Базовая цена, сом *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PriceBox" Text="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Ед. изм." Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UnitBox" Text="шт"/>
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
