<Window x:Class="PrintShop.App.Views.Dialogs.ServiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга" Style="{StaticResource DialogWindow}">
    <StackPanel Margin="20" Width="320">
        <TextBlock Text="Название *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock Text="Цена, сом *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PriceBox" Text="0"/>
        <TextBlock Text="Способ начисления" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ChargeBox" DisplayMemberPath="Name" SelectedValuePath="Value"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
