<UserControl x:Class="PrintShop.App.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Заказы" Style="{StaticResource Header}"/>

        <!-- Фильтр -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,6,12,12">
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="№ заказа" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="110" Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Клиент (имя / телефон)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Width="190" Text="{Binding CustomerText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="170" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Дата приёма с" Style="{StaticResource FieldLabel}"/>
                    <DatePicker Width="140" SelectedDate="{Binding From}"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="по" Style="{StaticResource FieldLabel}"/>
                    <DatePicker Width="140" SelectedDate="{Binding To}"/>
                </StackPanel>
                <CheckBox Content="Только активные" IsChecked="{Binding OnlyActive}" VerticalAlignment="Bottom" Margin="0,0,12,6"/>
                <Button Content="🔍 Найти" Command="{Binding SearchCommand}" VerticalAlignment="Bottom"/>
                <Button Content="Сбросить" Command="{Binding ResetCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </Border>

        <!-- Панель действий -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="＋ Новый заказ" Command="{Binding NewCommand}" Style="{StaticResource AccentButton}"
                    Visibility="{Binding CanEditOrders, Converter={StaticResource BoolToVis}}"/>
            <Button Content="✎ Изменить" Command="{Binding EditCommand}"
                    Visibility="{Binding CanEditOrders, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Подробно" Command="{Binding DetailsCommand}"/>
            <Button Content="💳 Оплата" Command="{Binding PaymentCommand}"
                    Visibility="{Binding CanAcceptPayments, Converter={StaticResource BoolToVis}}"/>
            <Button Content="🧾 Квитанция" Command="{Binding ReceiptCommand}"/>
            <Button Content="✖ Отменить заказ" Command="{Binding CancelOrderCommand}" Style="{StaticResource DangerButton}"
                    Visibility="{Binding CanEditOrders, Converter={StaticResource BoolToVis}}"/>
            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="4,0,12,0"/>
            <TextBlock Text="Перевести в:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="180" ItemsSource="{Binding NextStatuses}" SelectedItem="{Binding TargetStatus}" DisplayMemberPath="Name" Margin="0,0,8,0"/>
            <Button Content="Сменить статус" Command="{Binding ChangeStatusCommand}"/>
        </WrapPanel>

        <!-- Легенда и итоги -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Border Background="{StaticResource OverdueBrush}" Width="14" Height="14" Margin="0,0,4,0"/>
                <TextBlock Text="просрочен" Margin="0,0,12,0"/>
                <Border Background="{StaticResource TodayBrush}" Width="14" Height="14" Margin="0,0,4,0"/>
                <TextBlock Text="срок сегодня" Margin="0,0,12,0"/>
                <Border Background="{StaticResource ClosedBrush}" Width="14" Height="14" Margin="0,0,4,0"/>
                <TextBlock Text="готов / закрыт"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" Foreground="#46525F"/>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" MouseDoubleClick="Grid_DoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DueState}" Value="Overdue">
                            <Setter Property="Background" Value="{StaticResource OverdueBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DueState}" Value="Today">
                            <Setter Property="Background" Value="{StaticResource TodayBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DueState}" Value="Closed">
                            <Setter Property="Background" Value="{StaticResource ClosedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="85"/>
                <DataGridTextColumn Header="Принят" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="85"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="85"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Customer}" Width="2*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                <DataGridTextColumn Header="Продукция" Binding="{Binding Products}" Width="2*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Оплачено" Binding="{Binding Paid, StringFormat=N2}" Width="90"/>
                <DataGridTextColumn Header="Долг" Binding="{Binding Debt, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Менеджер" Binding="{Binding Manager}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
